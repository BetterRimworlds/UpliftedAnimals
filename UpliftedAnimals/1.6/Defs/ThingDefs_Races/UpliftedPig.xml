<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>Uplifted_Pig</defName>
    <label>uplifted pig</label>
    <description>An intelligent, social, and sentient pig uplifted by ALZ-112. Its enhanced brain allows advanced training and complex work, while its reinforced immune system provides improved resistance to toxic environments. Uplifted pigs remain efficient omnivores, but require more food to sustain their expanded cognition.</description>
    <statBases>
      <MoveSpeed>3.9</MoveSpeed>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <MarketValue>220</MarketValue>
      <FilthRate>8</FilthRate>
      <Wildness>0</Wildness>
      <ToxicEnvironmentResistance>0.9</ToxicEnvironmentResistance>
    </statBases>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <baseBodySize>1.7</baseBodySize>
      <baseHealthScale>0.7</baseHealthScale>
      <baseHungerRate>0.80</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <willNeverEat>
        <li>Plant_Rice</li>
        <li>Plant_Potato</li>
        <li>Plant_Corn</li>
        <li>Plant_Strawberry</li>
        <li>Plant_Haygrass</li>
        <li>Plant_Cotton</li>
        <li>Plant_Devilstrand</li>
        <li>Plant_Healroot</li>
        <li>Plant_Hops</li>
        <li>Plant_Smokeleaf</li>
        <li>Plant_Psychoid</li>
        <li>Plant_Tinctoria</li>
        <li>MealSimple</li>
        <li>MealFine</li>
        <li>MealFine_Veg</li>
        <li>MealFine_Meat</li>
        <li>MealLavish</li>
        <li>MealLavish_Veg</li>
        <li>MealLavish_Meat</li>
        <li>MealNutrientPaste</li>
        <li>MealSurvivalPack</li>
        <li>Pemmican</li>
      </willNeverEat>
      <leatherDef>Leather_Pig</leatherDef>
      <!-- roamMtbDays omitted on purpose: roamers are pen animals and cannot be assigned allowed areas. -->
      <petness>1</petness>
      <herdMigrationAllowed>false</herdMigrationAllowed>
      <neverIncludeInQuests>true</neverIncludeInQuests>
      <trainability>Advanced</trainability>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Forage</li>
      </specialTrainables>
      <meatLabel>pork</meatLabel>
      <gestationPeriodDays>5.661</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.7, 1)</li>
          <li>(2.0, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>35</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>4</minAge>
          <soundWounded>Pawn_Wildboar_Wounded</soundWounded>
          <soundDeath>Pawn_Wildboar_Death</soundDeath>
          <soundCall>Pawn_Wildboar_Call</soundCall>
          <soundAngry>Pawn_Wildboar_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
      <headPosPerRotation>
        <li>(0.0, 0, 0.05)</li>
        <li>(0.11, 0, -0.01)</li>
        <li>(0.0, 0, -0.05)</li>
        <li>(-0.11, 0, -0.01)</li>
      </headPosPerRotation>
    </race>
    <tradeability>Sellable</tradeability>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>7.3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  </ThingDef>

