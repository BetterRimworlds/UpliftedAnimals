<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="DrugPillBase">
		<defName>ALZ-112_Drug</defName>
		<label>ALZ-112</label>
		<description>A neurogenerative mRNA drug that either greatly increases intelligence and strength or kills any being exposed. 90% fatal in untested animals.</description>
		<descriptionHyperlinks>
			<HediffDef>ALZ112Exposure</HediffDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Item/Drugs</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>700</MarketValue>
			<Mass>0.01</Mass>
		</statBases>
		<techLevel>Ultra</techLevel>
		<minRewardCount>1</minRewardCount>
		<ingestible>
			<drugCategory>Medical</drugCategory>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>ALZ112Exposure</hediffDef>
					<severity>0.25</severity>
					<doToGeneratedPawnIfAddicted>false</doToGeneratedPawnIfAddicted>
				</li>
			</outcomeDoers>
		</ingestible>
		<comps>
			<li Class="CompProperties_Drug">
				<chemical>ALZ-112</chemical>
				<addictiveness>0</addictiveness>
				<needLevelOffset>0</needLevelOffset>
				<listOrder>1011</listOrder>
				<teetotalerCanConsume>true</teetotalerCanConsume>
			</li>
		</comps>
		<tradeTags>
			<li>ExoticMisc</li>
		</tradeTags>
		<thingSetMakerTags><li>RewardStandardLowFreq</li></thingSetMakerTags>
	</ThingDef>

	<ChemicalDef>
		<defName>ALZ-112</defName>
		<label>ALZ-112</label>
		<addictionHediff>ALZ112Exposure</addictionHediff>
		<canBinge>false</canBinge>
		<canBeAddicted>false</canBeAddicted>
	</ChemicalDef>

	<HediffDef>
		<defName>ALZ112Exposure</defName>
		<label>ALZ-112 Exposure</label>
		<description>This being has been exposed to the neurogenerative mRNA drug ALZ-112. They are violently ill and will seek a hospital bed. They will exhibit increased mental intelligence and strength, if they survive. Tending their wounds with medicine or glitterworld medicine eases the exposure; the exposure itself cannot be tended.</description>
		<hediffClass>BetterRimworlds.UpliftedAnimals.Hediff_ALZ112</hediffClass>
		<!--<causesNeed>Chemical_Luciferium</causesNeed>-->
		<everCurableByItem>true</everCurableByItem>
		<maxSeverity>1.0</maxSeverity>
		<lethalSeverity>-1</lethalSeverity>
		<alwaysShowSeverity>true</alwaysShowSeverity>
		<tendable>false</tendable>
		<isBad>true</isBad>
		<makesSickThought>true</makesSickThought>
		<scenarioCanAdd>false</scenarioCanAdd>
		<comps>
			<li Class="HediffCompProperties_Discoverable">
				<sendLetterWhenDiscovered>true</sendLetterWhenDiscovered>
			</li>
			<!-- Zero severity change. Tiny immunity gain exists only so
			     vanilla ShouldSeekMedicalRest treats them as sick (feed /
			     keep-lying-down / hospital AI). Hidden from the health tab. -->
			<li Class="HediffCompProperties_Immunizable">
				<hidden>true</hidden>
				<immunityPerDaySick>0.0001</immunityPerDaySick>
				<immunityPerDayNotSick>0.0001</immunityPerDayNotSick>
				<severityPerDayNotImmune>0</severityPerDayNotImmune>
				<severityPerDayImmune>0</severityPerDayImmune>
			</li>
<!--			<li Class="HediffCompProperties_ALZ112">-->
<!--			</li>-->
		</comps>
		<stages>
			<li>
				<label>bioactive</label>
				<painOffset>0.20</painOffset>
				<lifeThreatening>true</lifeThreatening>
				<hungerRateFactorOffset>5</hungerRateFactorOffset>
				<restFallFactorOffset>5</restFallFactorOffset>
				<vomitMtbDays>1.5</vomitMtbDays>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.50</offset>
					</li>
					<li>
						<capacity>Sight</capacity>
						<offset>-0.90</offset>
					</li>
					<li>
						<!-- Keep enough Moving to walk to a bed. Offset -0.75
						     after -0.50 consciousness is 0 (cannot path). -->
						<capacity>Moving</capacity>
						<setMax>0.35</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
	<HediffDef>
		<defName>ALZ112Uplifted</defName>
		<label>ALZ-112 Uplifted</label>
		<description>This being has been uplifted by the neurogenerative mRNA drug ALZ-112. They exhibit increased mental intelligence and strength.</description>
		<hediffClass>BetterRimworlds.UpliftedAnimals.Hediff_ALZ112Uplifted</hediffClass>
		<!--<causesNeed>Chemical_Luciferium</causesNeed>-->
		<everCurableByItem>false</everCurableByItem>
		<maxSeverity>1.0</maxSeverity>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<comps>
		</comps>
		<stages>
			<li>
				<painOffset>-0.10</painOffset>
				<lifeThreatening>false</lifeThreatening>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>0.50</offset>
					</li>
					<li>
						<capacity>Sight</capacity>
						<offset>0.25</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>0.15</offset>
					</li>
					<li>
						<capacity>Hearing</capacity>
						<offset>0.25</offset>
					</li>
					<li>
						<capacity>Metabolism</capacity>
						<offset>1.0</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
</Defs>
