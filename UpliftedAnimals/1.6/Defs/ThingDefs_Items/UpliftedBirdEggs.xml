<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="EggFertBase">
    <defName>Uplifted_EggCassowaryFertilized</defName>
    <label>uplifted cassowary egg (fert.)</label>
    <description>A fertilized egg laid by an uplifted cassowary. If all goes well, it should hatch into a baby uplifted cassowary. It can be eaten raw, but it's much better cooked.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <color>(125,138,97)</color>
      <drawSize>1.2</drawSize>
    </graphicData>
    <statBases>
      <Nutrition>0.5</Nutrition>
      <MarketValue>19.0</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>7</hatcherDaystoHatch>
        <hatcherPawn>Uplifted_Cassowary</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

