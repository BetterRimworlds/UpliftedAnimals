<!-- ==== Defs/ThingDefs_Races/UpliftedFoxes.xml ==== -->
<Defs>

  <ThingDef Name="ThingBaseUpliftedFox" ParentName="ThingBaseFox" Abstract="True">
    <statBases>
      <MarketValue>10000</MarketValue>
    </statBases>
    <race>
      <petness>1</petness>
      <wildness>0</wildness>
      <baseHungerRate>0.16</baseHungerRate>
      <trainability>Advanced</trainability>
      <lifeExpectancy>35</lifeExpectancy>
      <!-- Inherit="False" replaces ThingBaseFox's 3 stages instead of appending them (6 vs 3 PawnKind mismatch). -->
      <lifeStageAges Inherit="False">
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>4</minAge>
        </li>
      </lifeStageAges>
    </race>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBaseFox" Name="AnimalKindBaseUpliftedFox" Abstract="True">
    <combatPower>55</combatPower>
    <ecoSystemWeight>0.05</ecoSystemWeight>
  </PawnKindDef>


  <!--========================== Uplifted fennec fox ========================-->

  <ThingDef ParentName="ThingBaseUpliftedFox">
    <defName>Uplifted_Fox_Fennec</defName>
    <label>uplifted fennec fox</label>
    <description>An intelligent, adventurous, and sentient fennec fox uplifted by ALZ-112. Its enhanced brain gives it unusual trainability and problem-solving ability.</description>
    <statBases>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
    </statBases>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBaseUpliftedFox">
    <defName>Uplifted_Fox_Fennec</defName>
    <label>uplifted fennec fox</label>
    <labelFemale>uplifted fennec vixen</labelFemale>
    <race>Uplifted_Fox_Fennec</race>
    <lifeStages>
      <li>
        <label>uplifted fennec fox puppy</label>
        <labelFemale>uplifted fennec vixen puppy</labelFemale>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Fox_Fennec/Fox_Fennec</texPath>
          <drawSize>0.9</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Fox_Fennec/Dessicated_Fox_Fennec</texPath>
          <drawSize>0.9</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Fox_Fennec/Fox_Fennec</texPath>
          <drawSize>1.2</drawSize>
          <shadowData>
            <volume>(0.25, 0.3, 0.25)</volume>
            <offset>(0,0,-0.15)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Fox_Fennec/Dessicated_Fox_Fennec</texPath>
          <drawSize>1.2</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Fox_Fennec/Fox_Fennec</texPath>
          <drawSize>1.45</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Fox_Fennec/Dessicated_Fox_Fennec</texPath>
          <drawSize>1.45</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>


